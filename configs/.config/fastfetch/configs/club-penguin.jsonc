{
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
        "modules": [
                "title",
                {
                        "type": "custom",
                        "key": "┌{$1} {#33}Softwares",
                        "outputColor": "33"
                },
                {
                        "type": "os",
                        "key": "{$2}OS"
                },
                {
                        "type": "uptime",
                        "key": "{$2}Uptime"
                },
                {
                        "type": "packages",
                        "key": "{$2}Packages"
                },
                {
                        "type": "wm",
                        "key": "{$2}WM"
                },
                {
                        "type": "terminal",
                        "key": "{$2}Terminal"
                },
                {
                        "type": "terminalfont",
                        "key": "{$2}Terminal Font"
                },
                {
                        "type": "custom",
                        "key": "┌{$1} {#33}Hardwares",
                        "outputColor": "33"
                },
                {
                        "type": "cpu",
                        "key": "{$2}CPU"
                },
                {
                        "type": "gpu",
                        "key": "{$2}GPU"
                },
                {
                        "type": "memory",
                        "key": "{$2}Memory",
                        "percent": {
                                "type": 3
                        }
                },
                {
                        "type": "disk",
                        "key": "{$2}Disk",
                        "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage})"
                },
                {
                        "type": "battery",
                        "key": "{$2}Battery",
                        "percent": {
                                "type": 3
                        }
                },
                "break",
                "colors"
        ],
        "display": {
                "separator": "",
                "constants": [
                        "─────────",
                        "│ "
                ],
                "color": {
                        "keys": "white",
                        "title": "blue"
                },
                "percent": {
                        "type": ["num", "bar"]
                },
                "key": {
                        "width": 20
                }
        },
        "logo": {
        "source": "$XDG_CONFIG_HOME/fastfetch/logos/club-penguin.png",
        "height": 20
    }
}