# Syntax highlighting (fast-syntax-highlighting)

# No red overflow warning in git commit messages
FAST_HIGHLIGHT[git-cmsg-len]=1000000

# Quoted strings (commit messages etc.) in soft sage green
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}double-quoted-argument]=fg=108
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}single-quoted-argument]=fg=108
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}dollar-quoted-argument]=fg=108
